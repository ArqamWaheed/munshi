# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=            # https://aistudio.google.com/apikey  (free, no card)
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_RPM=14
GEMMA_JSON_MODE=1          # auto-disabled if the API rejects response_format for Gemma
GEMMA_THINKING_LEVEL=minimal

TINKER_API_KEY=            # https://tinker.thinkingmachines.ai/keys  (or `tinker auth login`)
TINKER_BASE_MODEL=Qwen/Qwen3.5-4B
TINKER_MODEL_PATH=         # filled after train/tinker_sft.py: tinker://<run_id>/sampler_weights/munshi-parser
TINKER_USE_CHAT_ENDPOINT=0

TABPFN_TOKEN=              # https://platform.priorlabs.ai/account/api-keys
TABPFN_VERSION=v3.5
REGISTER_CSV=              # optional: first user's own register (hotels.csv columns)

SERPAPI_API_KEY=           # https://serpapi.com/manage-api-key  (free: 250/month, 50/hour)
COMPS_QUERY=hotels in Murree
SERPAPI_MONTHLY_BUDGET=200

SENTRY_DSN=                # Sentry project -> Settings -> Client Keys (DSN). Empty = tracing off.
SENTRY_ENV=dev

HOTEL_NAME=Hotel Demo Murree
BASE_RATE_PKR=8000
FLOOR_RATE_PKR=5000
DEMO_SPEED=1               # 60 => a 2 h hold expires in 2 min
TEMPORAL_ADDRESS=localhost:7233
TASK_QUEUE=munshi
MUNSHI_INJECT_FAILURE_RATE=0   # e.g. 0.5 during the demo to force visible retries (first attempt only)

HF_HUB_DISABLE_TELEMETRY=1
# HF_HOME=D:\hf-cache      # optional: put the ~30 MB tokenizer cache on another drive
